{
  "name": "exif-crop-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "零后端 EXIF 方向感知裁切工具（Vue 3 + TypeScript + Canvas）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.4",
    "vue-tsc": "^2.1.6"
  }
}
